model User {
  id           String       @id @default(uuid())
  name         String       @db.VarChar(255)
  email        String       @unique
  password     String
  activeStatus ActiveStatus @default(ACTIVE) @map("activestatus")
  role         Role         @default(CUSTOMER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  profile   Profile?
  gearItems GearItem[] @relation("ProviderGear")

  @@index([role])
  @@index([activeStatus])
  @@map("user")
}
