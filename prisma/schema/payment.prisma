model Payment {
  id String @id @default(uuid())

  rentalOrderId String
  rentalOrder   RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Restrict)

  customerId String
  customer   User   @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: Restrict)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("usd") @db.VarChar(10)

  paymentProvider PaymentProvider @default(STRIPE)
  status          PaymentStatus   @default(PENDING)

  transactionId   String? @unique @db.VarChar(255)
  stripeSessionId String? @unique @db.VarChar(255)
  paymentIntentId String? @unique @db.VarChar(255)
  paymentMethod   String? @db.VarChar(100)

  failureReason String? @db.Text

  paidAt   DateTime?
  failedAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rentalOrderId])
  @@index([customerId])
  @@index([status])
  @@index([paymentProvider])
  @@index([createdAt])
  @@map("payments")
}
